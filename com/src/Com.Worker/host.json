{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request;Exception"
      }
    },
    "logLevel": {
      "default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "extensions": {
    "serviceBus": {
      "maxAutoLockRenewalDuration": "00:05:00",
      "maxConcurrentCalls": 4,
      "autoCompleteMessages": true
    }
  }
}
